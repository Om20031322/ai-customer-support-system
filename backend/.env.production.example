NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/customer_support?schema=public
JWT_SECRET=replace_with_long_random_production_secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
AI_SERVICE_URL=https://ai-service.example.com

GOOGLE_CLIENT_ID=replace_with_google_client_id
REDIS_URL=redis://ELASTICACHE_HOST:6379

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_smtp_user
EMAIL_PASS=replace_with_smtp_password
EMAIL_FROM=support@example.com

KAFKA_BROKERS=MSK_BROKER_1:9092,MSK_BROKER_2:9092
KAFKA_CLIENT_ID=customer-support-backend
KAFKA_TICKET_CREATED_TOPIC=tickets.created
KAFKA_TICKET_PROCESSED_TOPIC=tickets.processed
KAFKA_TICKET_RETRY_TOPIC=tickets.retry
KAFKA_TICKET_DEAD_LETTER_TOPIC=tickets.dead-letter
