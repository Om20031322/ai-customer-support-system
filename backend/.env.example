NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_support?schema=public

JWT_SECRET=replace_with_secure_jwt_secret
JWT_EXPIRES_IN=1d

PORT=4000

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

GOOGLE_CLIENT_ID=replace_with_google_client_id
REDIS_URL=redis://localhost:6379
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=customer-support-backend
KAFKA_TICKET_CREATED_TOPIC=tickets.created
KAFKA_TICKET_PROCESSED_TOPIC=tickets.processed
KAFKA_TICKET_RETRY_TOPIC=tickets.retry
KAFKA_TICKET_DEAD_LETTER_TOPIC=tickets.dead-letter
